      <!-- Type dropdown -->
      <div class="nav-item dropdown-parent" data-dropdown="type">
        Type ▾
        <div class="dropdown-panel" id="typeDropdown">
          <div class="dropdown-col">
            <a href="/type/Anime" class="dropdown-item">Anime</a>
            <a href="/type/Drama" class="dropdown-item">Drama</a>
            <a href="/type/Movie" class="dropdown-item">Movie</a>
            <a href="/type/TV+Show" class="dropdown-item">TV Show</a>
            <a href="/type/Web+Series" class="dropdown-item">Web Series</a>
          </div>
        </div>
      </div>

      <!-- Other links -->
      <a href="/search?q=ongoing" class="nav-item">Ongoing</a>
      <a href="/updates" class="nav-item">Updates</a>
      <a href="/news" class="nav-item">News</a>
      <a href="/forum" class="nav-item">Forum</a>

      <!-- Search bar -->
      <div class="search-wrapper" id="searchWrapper">
        <div class="search-toggle" id="searchToggle">
          <button class="active" data-mode="non-anime">Non-Anime</button>
          <button data-mode="anime">Anime</button>
        </div>
        <input type="text" class="search-input" id="searchInput" placeholder="Search..." autocomplete="off" />
        <div class="search-suggestions" id="searchSuggestions"></div>
      </div>

      <!-- Social icons -->
      <div class="social-icons">
        <!-- Discord -->
        <a href="https://discord.gg/" target="_blank" title="Discord">
          <svg viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.947 2.418-2.157 2.418z"/></svg>
        </a>
        <!-- Tumblr -->
        <a href="https://www.tumblr.com/" target="_blank" title="Tumblr">
          <svg viewBox="0 0 24 24"><path d="M14.563 24c-5.093 0-7.031-3.756-7.031-6.411V9.747H5.116V6.648c3.63-1.313 4.512-4.596 4.71-6.469C9.84.058 9.941 0 10.062 0h3.508v6.114h4.693v3.633h-4.693v7.74c0 1.788.449 2.934 2.865 2.934h.033c.626 0 1.158-.032 1.697-.105v3.497c-.733.188-2.057.187-3.602.187z"/></svg>
        </a>
        <!-- Bluesky -->
        <a href="https://bsky.app/" target="_blank" title="Bluesky">
          <svg viewBox="0 0 24 24"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.045.415-.07-.136.028-.275.054-.415.07-3.358.476-6.312 1.727-2.37 6.071 4.242 4.67 6.098-1.168 6.572-4.48.043-.302.065-.557.065-.79 0 .233.022.488.065.79.474 3.312 2.33 9.15 6.572 4.48 3.942-4.344.988-5.595-2.37-6.071-.14-.015-.28-.041-.415-.07.14.025.279.05.415.07 2.67.296 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8Z"/></svg>
        </a>
        <!-- X (Twitter) -->
        <a href="https://x.com/" target="_blank" title="X">
          <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>

      <!-- Auth area -->
      {user ? (
