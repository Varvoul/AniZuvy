---
// src/layouts/BaseLayout.astro
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// Get current user (if logged in)
const { data: { session } } = await supabase.auth.getSession();
const user = session?.user ?? null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AniZuvy</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Cloudflare Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <style>
    /* ───── GLOBAL RESET & VARIABLES ───── */
    :root {
      --bg-body: #132633;
      --bg-header: #1e2d3a;
      --text-widget-title: #a2c4de;
      --btn-primary: #597691;
      --btn-primary-hover: #455d73;
      --btn-secondary: #5d7080;
      --btn-secondary-hover: #4a5a69;
      --btn-text: #ffffff;
      --popup-bg: #506096;
      --popup-btn: #C0A8FF;
      --popup-btn-text: #1A1A2E;
      --popup-btn-hover: #CFBBFF;
      --show-info-bg: #283654;
      --genre-tag-bg: #bf8fe3;
      --link-accent: #FF7B9C;
      --ep-current: #3B7A99;
      --ep-watched: #476d80;
      --footer-bg: #d4d6d8;
      --dropdown-hover-text: #8ba3f0;
      --font-title: 'Archivo Black', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-meta: 'Poppins', sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font-body); color: #fff; background: var(--bg-body); line-height: 1.5; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; }

    /* ───── HEADER ───── */
    .site-header {
      background: var(--bg-header);
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .header-left { display: flex; align-items: center; gap: 24px; }
    .logo img { height: 40px; width: auto; }
    .logo a { display: inline-block; }

    /* Desktop nav */
    .desktop-nav { display: flex; align-items: center; gap: 20px; }
    .nav-item {
      position: relative;
      color: #fff;
      font-weight: 500;
      font-size: 0.9rem;
      cursor: pointer;
      padding: 20px 0;
      user-select: none;
    }
    .nav-item::after {
      content: '';
      position: absolute;
      bottom: 14px;
      left: 0;
      height: 2px;
      width: 0;
      background: var(--popup-btn);
      transition: width 0.25s ease;
    }
    .nav-item:hover::after, .nav-item.active::after { width: 45%; }

    /* Dropdown panel */
    .dropdown-panel {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: var(--bg-body);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 12px;
      min-width: 220px;
      z-index: 101;
      box-shadow: 0 8px 24px rgba(0,0,0,0.6);
      gap: 24px;
    }
    .dropdown-panel.show { display: flex; }
    .dropdown-col { display: flex; flex-direction: column; gap: 4px; }
    .dropdown-item {
      padding: 6px 10px;
      font-size: 0.85rem;
      border-radius: 4px;
      cursor: pointer;
      white-space: nowrap;
      color: rgba(255,255,255,0.85);
    }
    .dropdown-item:hover {
      background: var(--popup-btn);
      color: var(--popup-btn-text);
    }

    /* Search bar */
    .search-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      background: rgba(255,255,255,0.08);
      border-radius: 32px;
      padding: 4px 8px;
      margin-left: 10px;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .search-toggle {
      display: flex;
      background: rgba(255,255,255,0.05);
      border-radius: 24px;
      overflow: hidden;
      margin-right: 6px;
    }
    .search-toggle button {
      background: none;
      border: none;
      color: rgba(255,255,255,0.5);
      padding: 4px 12px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: 0.2s;
    }
    .search-toggle button.active { background: var(--popup-btn); color: var(--popup-btn-text); }
    .search-input {
      background: none;
      border: none;
      color: #fff;
      font-size: 0.9rem;
      outline: none;
      width: 180px;
    }
    .search-suggestions {
      display: none;
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      width: 360px;
      background: var(--bg-body);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      max-height: 360px;
      overflow-y: auto;
      z-index: 102;
      padding: 8px 0;
      box-shadow: 0 8px 24px rgba(0,0,0,0.6);
    }
    .search-suggestions.show { display: block; }
    .suggestion-item {
      display: flex;
      gap: 12px;
      padding: 8px 10px;
      cursor: pointer;
      align-items: center;
      color: #fff;
    }
    .suggestion-item:hover { background: var(--popup-btn); color: var(--popup-btn-text); }
    .suggestion-item img { width: 40px; height: 56px; border-radius: 4px; object-fit: cover; }
    .suggestion-meta { font-size: 0.75rem; color: rgba(255,255,255,0.6); }
    .view-all-btn {
      display: block;
      text-align: center;
      padding: 8px 16px;
      border: 1px solid var(--popup-btn);
      border-radius: 30px;
      margin: 8px auto 0;
      color: var(--popup-btn);
      font-weight: 600;
      width: fit-content;
      cursor: pointer;
    }

    /* Social icons */
    .social-icons { display: flex; gap: 10px; margin-left: 10px; }
    .social-icons a svg { width: 20px; height: 20px; fill: rgba(255,255,255,0.6); transition: fill 0.2s; }
    .social-icons a:hover svg { fill: #fff; }

    /* Auth button */
    .auth-btn {
      background: var(--popup-btn);
      color: var(--popup-btn-text);
      border: none;
      border-radius: 30px;
      padding: 6px 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      margin-left: 10px;
    }
    .auth-btn:hover { background: var(--popup-btn-hover); }
    .user-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; cursor: pointer; margin-left: 10px; }

    /* ───── AUTH MODAL ───── */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.75);
      z-index: 2000;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.show { display: flex; }
    .auth-modal {
      display: flex;
      background: var(--bg-body);
      border-radius: 16px;
      overflow: hidden;
      width: 90%;
      max-width: 700px;
      position: relative;
      box-shadow: 0 16px 48px rgba(0,0,0,0.5);
    }
    .modal-close {
      position: absolute;
      top: 12px; right: 16px;
      font-size: 1.5rem;
      cursor: pointer;
      color: rgba(255,255,255,0.6);
      z-index: 10;
    }
    .modal-close:hover { color: #fff; }
    .auth-image {
      flex: 0 0 45%;
      display: none; /* hidden on small screens, shown on desktop via media query */
    }
    .auth-image img { width: 100%; height: 100%; object-fit: cover; }
    .auth-form {
      flex: 1;
      padding: 32px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .auth-form h2 { font-size: 1.5rem; margin-bottom: 24px; }
    .auth-form input {
      width: 100%;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 16px;
      color: #fff;
      font-size: 0.95rem;
    }
    .auth-form input::placeholder { color: rgba(255,255,255,0.5); }
    .auth-form .form-footer {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 16px;
    }
    .forgot-link { color: var(--popup-btn); font-size: 0.85rem; }
    .btn-submit {
      background: var(--popup-btn);
      color: var(--popup-btn-text);
      border: none;
      border-radius: 30px;
      padding: 12px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 12px;
    }
    .btn-submit:hover { background: var(--popup-btn-hover); }
    .switch-text { font-size: 0.9rem; margin-top: 12px; text-align: center; }
    .switch-text a { color: var(--popup-btn); font-weight: 600; }

    /* Mobile hamburger */
    .hamburger { display: none; flex-direction: column; gap: 4px; cursor: pointer; }
    .hamburger span { width: 24px; height: 2px; background: #fff; border-radius: 2px; }

    /* Mobile menu overlay */
    .mobile-menu-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.6);
      z-index: 200;
      display: none;
    }
    .mobile-menu-overlay.show { display: block; }
    .mobile-menu-panel {
      position: fixed;
      top: 0; left: 0;
      width: 75%;
      max-width: 320px;
      height: 100%;
      background: var(--bg-header);
      z-index: 201;
      padding: 20px;
      overflow-y: auto;
    }
    .mobile-nav-item {
      display: block;
      padding: 12px 0;
      font-weight: 600;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .mobile-nav-item:hover { color: var(--popup-btn); }
    .mobile-submenu { padding-left: 16px; margin: 4px 0; display: none; }
    .mobile-submenu.show { display: block; }
    .mobile-submenu a {
      display: block;
      padding: 6px 0;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.7);
    }

    /* ───── FOOTER ───── */
    .site-footer {
      background: var(--footer-bg);
      color: #1a1a2e;
      padding: 40px 24px;
      margin-top: 80px;
    }
    .footer-content {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 40px;
    }
    .footer-left { max-width: 500px; }
    .footer-logo img { height: 50px; }
    .footer-meta { margin: 12px 0; font-size: 0.9rem; opacity: 0.8; }
    .footer-social-title { font-size: 1rem; margin-bottom: 8px; }
    .footer-social-icons { display: flex; gap: 12px; margin-bottom: 20px; }
    .footer-social-icons a svg { width: 24px; height: 24px; fill: #1a1a2e; transition: opacity 0.2s; }
    .footer-social-icons a:hover svg { opacity: 0.7; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 16px; font-size: 0.85rem; }
    .footer-links a { font-weight: 500; }
    .footer-right img { max-height: 300px; object-fit: contain; }
    .disclaimer, .copyright { font-size: 0.8rem; opacity: 0.7; margin-top: 10px; }

    /* ───── RESPONSIVE ───── */
    @media (min-width: 769px) {
      .auth-image { display: block; }
    }
    @media (max-width: 1024px) {
      .desktop-nav { display: none; }
      .hamburger { display: flex; }
      /* show mobile right icons */
      .mobile-right { display: flex !important; align-items: center; gap: 12px; }
    }
    @media (max-width: 768px) {
      .footer-content { flex-direction: column; }
      .footer-right { display: none; }
    }
  </style>
</head>
<body>
  <!-- ========== HEADER ========== -->
  <header class="site-header">
    <!-- Left: hamburger + logo -->
    <div class="header-left">
      <div class="hamburger" id="hamburgerBtn">
        <span></span><span></span><span></span>
      </div>
      <div class="logo">
        <a href="/"><img src="/logo.png" alt="AniZuvy" id="siteLogo" /></a>
      </div>
    </div>

    <!-- Desktop navigation -->
    <nav class="desktop-nav">
      <!-- Home -->
      <a href="/" class="nav-item">Home</a>

      <!-- Genre dropdown -->
      <div class="nav-item dropdown-parent" data-dropdown="genre">
        Genre ▾
        <div class="dropdown-panel" id="genreDropdown">
          <div class="dropdown-col">
            <a href="/genre/Action" class="dropdown-item">Action</a>
            <a href="/genre/Adventure" class="dropdown-item">Adventure</a>
            <a href="/genre/Comedy" class="dropdown-item">Comedy</a>
            <a href="/genre/Drama" class="dropdown-item">Drama</a>
            <a href="/genre/Fantasy" class="dropdown-item">Fantasy</a>
            <a href="/genre/Horror" class="dropdown-item">Horror</a>
            <a href="/genre/Mystery" class="dropdown-item">Mystery</a>
            <a href="/genre/Romance" class="dropdown-item">Romance</a>
            <a href="/genre/Sci-Fi" class="dropdown-item">Sci-Fi</a>
            <a href="/genre/Seinen" class="dropdown-item">Seinen</a>
            <a href="/genre/Shoujo" class="dropdown-item">Shoujo</a>
            <a href="/genre/Shounen" class="dropdown-item">Shounen</a>
            <a href="/genre/Slice+of+Life" class="dropdown-item">Slice of Life</a>
            <a href="/genre/Sports" class="dropdown-item">Sports</a>
            <a href="/genre/Supernatural" class="dropdown-item">Supernatural</a>
          </div>
          <div class="dropdown-col">
            <a href="/genre/Thriller" class="dropdown-item">Thriller</a>
            <a href="/genre/Yaoi" class="dropdown-item">Yaoi</a>
            <a href="/genre/Yuri" class="dropdown-item">Yuri</a>
            <a href="/genre/Isekai" class="dropdown-item">Isekai</a>
            <a href="/genre/Mecha" class="dropdown-item">Mecha</a>
            <a href="/genre/Historical" class="dropdown-item">Historical</a>
            <a href="/genre/Military" class="dropdown-item">Military</a>
            <a href="/genre/Music" class="dropdown-item">Music</a>
            <a href="/genre/Psychological" class="dropdown-item">Psychological</a>
            <a href="/genre/School" class="dropdown-item">School</a>
            <a href="/genre/Vampire" class="dropdown-item">Vampire</a>
            <a href="/genre/Game" class="dropdown-item">Game</a>
            <a href="/genre/Demons" class="dropdown-item">Demons</a>
            <a href="/genre/Ecchi" class="dropdown-item">Ecchi</a>
            <a href="/genre/Josei" class="dropdown-item">Josei</a>
          </div>
        </div>
      </div>

      <!-- Country dropdown -->
      <div class="nav-item dropdown-parent" data-dropdown="country">
        Country ▾
        <div class="dropdown-panel" id="countryDropdown">
          <div class="dropdown-col">
            <a href="/country/Japan" class="dropdown-item">Japan</a>
            <a href="/country/South+Korea" class="dropdown-item">South Korea</a>
            <a href="/country/China" class="dropdown-item">China</a>
            <a href="/country/USA" class="dropdown-item">USA</a>
            <a href="/country/UK" class="dropdown-item">UK</a>
            <a href="/country/Canada" class="dropdown-item">Canada</a>
            <a href="/country/France" class="dropdown-item">France</a>
            <a href="/country/Germany" class="dropdown-item">Germany</a>
            <a href="/country/India" class="dropdown-item">India</a>
            <a href="/country/Philippines" class="dropdown-item">Philippines</a>
            <a href="/country/Thailand" class="dropdown-item">Thailand</a>
            <a href="/country/Taiwan" class="dropdown-item">Taiwan</a>
            <a href="/country/Hong+Kong" class="dropdown-item">Hong Kong</a>
            <a href="/country/Australia" class="dropdown-item">Australia</a>
            <a href="/country/Mexico" class="dropdown-item">Mexico</a>
          </div>
