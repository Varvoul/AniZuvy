            <a href="/country/Brazil" class="dropdown-item">Brazil</a>
            <a href="/country/Argentina" class="dropdown-item">Argentina</a>
            <a href="/country/Spain" class="dropdown-item">Spain</a>
            <a href="/country/Italy" class="dropdown-item">Italy</a>
            <a href="/country/Russia" class="dropdown-item">Russia</a>
            <a href="/country/Turkey" class="dropdown-item">Turkey</a>
            <a href="/country/Indonesia" class="dropdown-item">Indonesia</a>
            <a href="/country/Malaysia" class="dropdown-item">Malaysia</a>
            <a href="/country/Singapore" class="dropdown-item">Singapore</a>
            <a href="/country/Nigeria" class="dropdown-item">Nigeria</a>
