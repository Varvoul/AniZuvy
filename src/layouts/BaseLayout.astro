  <!-- ========== SCRIPTS ========== -->
  <script>
    // ── Helper: Supabase client already initialized ──
    // (If you need to use it in scripts, it's available as `supabase`)

    // ── Desktop dropdowns (show on hover) ──
    document.querySelectorAll('.dropdown-parent').forEach(parent => {
      const panel = parent.querySelector('.dropdown-panel');
      parent.addEventListener('mouseenter', () => panel.classList.add('show'));
      parent.addEventListener('mouseleave', () => panel.classList.remove('show'));
    });

    // ── Mobile hamburger menu ──
    const hamburgerBtn = document.getElementById('hamburgerBtn');
    const mobileOverlay = document.getElementById('mobileOverlay');
    const mobilePanel = document.getElementById('mobilePanel');
    hamburgerBtn?.addEventListener('click', () => {
      mobileOverlay.classList.toggle('show');
    });
    mobileOverlay?.addEventListener('click', (e) => {
      if (e.target === mobileOverlay) {
        mobileOverlay.classList.remove('show');
      }
    });

    // Mobile submenu toggles
    const toggleSubmenu = (toggleId, subId) => {
      document.getElementById(toggleId)?.addEventListener('click', () => {
        document.getElementById(subId).classList.toggle('show');
      });
    };
    toggleSubmenu('mobileGenreToggle', 'mobileGenreSub');
    toggleSubmenu('mobileCountryToggle', 'mobileCountrySub');
    toggleSubmenu('mobileTypeToggle', 'mobileTypeSub');

    // ── Search Suggestions (desktop) ──
    const searchInput = document.getElementById('searchInput');
    const searchSuggestions = document.getElementById('searchSuggestions');
    const searchToggleBtns = document.querySelectorAll('#searchToggle button');
    let searchMode = 'non-anime';

    searchToggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        searchToggleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        searchMode = btn.dataset.mode;
        searchInput.value = '';
        searchSuggestions.classList.remove('show');
      });
    });

    let debounceTimer;
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = searchInput.value.trim();
      if (query.length < 3) {
        searchSuggestions.classList.remove('show');
        return;
      }
      debounceTimer = setTimeout(async () => {
        let url;
        if (searchMode === 'anime') {
          url = `https://api.jikan.moe/v4/anime?q=${encodeURIComponent(query)}&limit=7`;
        } else {
          url = `${import.meta.env.PUBLIC_TMDB_PROXY}/3/search/multi?query=${encodeURIComponent(query)}&include_adult=false&language=en-US&page=1`;
        }
        try {
          const res = await fetch(url);
          const data = await res.json();
          let items = [];
          if (searchMode === 'anime') {
            items = (data.data || []).map(a => ({
              id: a.mal_id,
              title: a.title,
              poster: a.images?.jpg?.image_url,
              type: 'Anime',
              year: a.aired?.from?.slice(0,4),
              score: a.score,
              episodes: a.episodes,
              studio: a.studios?.[0]?.name,
              url: `/details/jikan-${a.mal_id}`
            }));
          } else {
            items = (data.results || []).filter(i => i.media_type !== 'person').map(i => ({
              id: i.id,
              title: i.title || i.name,
              poster: i.poster_path ? `https://image.tmdb.org/t/p/w92${i.poster_path}` : '',
              type: i.media_type === 'movie' ? 'Movie' : 'TV',
              year: (i.release_date || i.first_air_date || '').slice(0,4),
              score: i.vote_average,
              url: `/details/tmdb-${i.id}`
            }));
          }
          renderSuggestions(items, searchSuggestions);
        } catch (e) {
          console.error('Search error:', e);
        }
      }, 300);
    });

    function renderSuggestions(items, container) {
      if (items.length === 0) {
        container.innerHTML = '<div class="suggestion-item">No results</div>';
      } else {
        container.innerHTML = items.map(item => `
          <a href="${item.url}" class="suggestion-item">
            <img src="${item.poster}" onerror="this.src='/no-poster.png'" />
            <div>
              <div><strong>${item.title}</strong></div>
              <div class="suggestion-meta">${item.type} · ${item.year || '?'} · ⭐ ${item.score || '?'}</div>
            </div>
          </a>
        `).join('') + `<a href="/search?q=${encodeURIComponent(searchInput.value)}" class="view-all-btn">View All</a>`;
      }
      container.classList.add('show');
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('#searchWrapper')) {
        searchSuggestions.classList.remove('show');
      }
    });

    // ── Mobile search bar toggle ──
    const mobileSearchIcon = document.getElementById('mobileSearchIcon');
    const mobileSearchBar = document.getElementById('mobileSearchBar');
    mobileSearchIcon?.addEventListener('click', () => {
      mobileSearchBar.style.display = mobileSearchBar.style.display === 'none' ? 'block' : 'none';
    });
    // Mobile search logic (similar to desktop, using its own input and suggestions container)
    const mobileSearchInput = document.getElementById('mobileSearchInput');
    const mobileSearchSuggestions = document.getElementById('mobileSearchSuggestions');
    const mobileToggleBtns = document.querySelectorAll('#mobileSearchBar .search-toggle button');
    let mobileMode = 'non-anime';
    mobileToggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mobileToggleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        mobileMode = btn.dataset.mode;
        mobileSearchInput.value = '';
        mobileSearchSuggestions.classList.remove('show');
      });
    });
    let mobileDebounce;
    mobileSearchInput?.addEventListener('input', () => {
      clearTimeout(mobileDebounce);
      const query = mobileSearchInput.value.trim();
      if (query.length < 3) {
        mobileSearchSuggestions.classList.remove('show');
        return;
      }
      mobileDebounce = setTimeout(async () => {
        let url;
        if (mobileMode === 'anime') {
          url = `https://api.jikan.moe/v4/anime?q=${encodeURIComponent(query)}&limit=7`;
        } else {
          url = `${import.meta.env.PUBLIC_TMDB_PROXY}/3/search/multi?query=${encodeURIComponent(query)}&include_adult=false&language=en-US&page=1`;
        }
        try {
          const res = await fetch(url);
          const data = await res.json();
          let items = [];
          if (mobileMode === 'anime') {
            items = (data.data || []).map(a => ({
              id: a.mal_id,
              title: a.title,
              poster: a.images?.jpg?.image_url,
              type: 'Anime',
              year: a.aired?.from?.slice(0,4),
              score: a.score,
              url: `/details/jikan-${a.mal_id}`
            }));
          } else {
            items = (data.results || []).filter(i => i.media_type !== 'person').map(i => ({
              id: i.id,
              title: i.title || i.name,
              poster: i.poster_path ? `https://image.tmdb.org/t/p/w92${i.poster_path}` : '',
              type: i.media_type === 'movie' ? 'Movie' : 'TV',
              year: (i.release_date || i.first_air_date || '').slice(0,4),
              score: i.vote_average,
              url: `/details/tmdb-${i.id}`
            }));
          }
          renderSuggestions(items, mobileSearchSuggestions);
        } catch (e) {
          console.error(e);
        }
      }, 300);
    });

    // ── Auth Modal ──
    const authModal = document.getElementById('authModal');
    const openAuthBtn = document.getElementById('openAuthModal');
    const closeAuthBtn = document.getElementById('closeAuthModal');
    const mobileAuthIcon = document.getElementById('mobileAuthIcon');

    function showAuthModal() { authModal.classList.add('show'); }
    function hideAuthModal() { authModal.classList.remove('show'); }

    openAuthBtn?.addEventListener('click', showAuthModal);
    mobileAuthIcon?.addEventListener('click', showAuthModal);
    closeAuthBtn?.addEventListener('click', hideAuthModal);
    window.addEventListener('click', (e) => {
      if (e.target === authModal) hideAuthModal();
    });

    // Switch between sign in / sign up
    document.getElementById('switchToSignUp')?.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('loginSection').style.display = 'none';
      document.getElementById('signupSection').style.display = 'block';
    });
    document.getElementById('switchToSignIn')?.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('signupSection').style.display = 'none';
      document.getElementById('loginSection').style.display = 'block';
    });

    // Handle login
    document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = e.target[0].value;
      const password = e.target[1].value;
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        alert(error.message);
      } else {
        location.reload();
      }
    });

    // Handle signup
    document.getElementById('signupForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = e.target[0].value;
      const email = e.target[1].value;
      const password = e.target[2].value;
      const confirm = e.target[3].value;
      if (password !== confirm) {
        alert('Passwords do not match');
        return;
      }
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: { data: { username } }
      });
      if (error) {
        alert(error.message);
      } else {
        alert('Account created! Please check your email (including spam) to confirm your address.');
        hideAuthModal();
      }
    });
  </script>
